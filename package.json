{
  "name": "jawa-apps",
  "productName": "JAWA",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop apps for JAWA POS, JAWA.FOOD and JAWA.SITE: each opens its live site in its own window.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "src/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "start:pos": "JAWA_APP=pos electron .",
    "start:food": "JAWA_APP=food electron .",
    "start:site": "JAWA_APP=site electron .",
    "test": "node --test test/unit/*.test.js",
    "test:e2e": "playwright test",
    "test:package": "node --test test/package/*.test.js",
    "dist": "node scripts/build.js"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.64.1",
    "electron": "44.10.0",
    "electron-builder": "26.17.0"
  }
}
